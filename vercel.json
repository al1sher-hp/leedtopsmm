{
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm --prefix web run build",
  "outputDirectory": "web/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/health", "destination": "/api" },
    { "source": "/((?!api/|health$).*)", "destination": "/index.html" }
  ]
}
