# Contabo VPS uchun production .env namunasi.
# Serverda: cp .env.prod.example .env && chmod 600 .env && nano .env
# Bu fayl HECH QACHON git'ga commit qilinmaydi.

# --- Postgres (faqat docker tarmog'i ichida ishlatiladi, tashqariga chiqmaydi) ---
POSTGRES_PASSWORD=

# --- Telegram (my.telegram.org) ---
API_ID=
API_HASH=
SESSION=

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- Postgres SSL (odatda kerak emas — postgres shu compose ichida) ---
# PGSSL=true
# PGSSL_REJECT_UNAUTHORIZED=true

# --- Ban-avoidance / rate limit ---
MAX_REQUESTS_PER_HOUR=250
MAX_REQUESTS_PER_DAY=2000
REQUEST_DELAY_MS=3000
REQUEST_DELAY_JITTER_MS=1500
DISCOVERY_DEPTH=2
# BLACKLIST_CACHE_TTL_MS=60000

# --- API ---
CORS_ORIGIN=*

# --- Faqat VARIANT B (Caddy) uchun kerak ---
# DOMAIN=leads.topsmm.uz
