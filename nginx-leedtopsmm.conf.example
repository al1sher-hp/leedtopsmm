# VARIANT A namunasi — serverda 80/443 allaqachon boshqa loyiha(lar) uchun
# nginx band qilgan holatda ishlatiladi. Bu MAVJUD nginx konfiguratsiyasini
# TAHRIRLAMAYDI — alohida, YANGI fayl sifatida qo'shiladi:
#
#   1. <DOMEN> o'rniga haqiqiy domenni yozing
#   2. Serverda: sudo cp nginx-leedtopsmm.conf.example /etc/nginx/sites-available/leedtopsmm
#   3. sudo ln -s /etc/nginx/sites-available/leedtopsmm /etc/nginx/sites-enabled/leedtopsmm
#   4. sudo nginx -t                 # sintaksisni tekshirish
#   5. sudo systemctl reload nginx   # restart EMAS — reload (eski saytlar uzilmaydi)
#   6. TLS uchun (certbot mavjud bo'lsa): sudo certbot --nginx -d <DOMEN>
#
# docker-compose.prod.variantA.yml web konteynerini 127.0.0.1:8081 ga
# bog'laydi — shuning uchun pastdagi proxy_pass shu portga ishora qiladi.

server {
    listen 80;
    listen [::]:80;
    server_name <DOMEN>;

    location /api/ {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
